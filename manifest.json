{
  "manifest_version": 3,
  "name": "FocusTube",
  "version": "1.3",
  "description": "Distraction-free YouTube. Hide feed, Shorts, comments, and recommendations to stay focused.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Toggle FocusTube"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}

